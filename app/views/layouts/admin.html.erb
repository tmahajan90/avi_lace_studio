<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Admin — Avi Lace Studio</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="UTF-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-layout">
    <aside class="admin-sidebar">
      <div class="admin-sidebar__brand">
        <%= link_to admin_root_path do %>
          <span>Avi Lace Studio</span>
          <small>Admin Panel</small>
        <% end %>
      </div>
      <nav class="admin-sidebar__nav">
        <%= link_to admin_root_path, class: "admin-sidebar__link" do %>Dashboard<% end %>
        <%= link_to admin_products_path, class: "admin-sidebar__link" do %>Products<% end %>
        <%= link_to admin_categories_path, class: "admin-sidebar__link" do %>Categories<% end %>
        <%= link_to admin_orders_path, class: "admin-sidebar__link" do %>Orders<% end %>
        <%= link_to admin_users_path, class: "admin-sidebar__link" do %>Customers<% end %>
        <hr class="admin-sidebar__divider">
        <%= link_to root_path, class: "admin-sidebar__link" do %>View Store<% end %>
        <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "admin-sidebar__link admin-sidebar__link--danger" do %>Sign Out<% end %>
      </nav>
    </aside>
    <div class="admin-main">
      <% if notice.present? %>
        <div class="flash flash--notice"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="flash flash--alert"><%= alert %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
