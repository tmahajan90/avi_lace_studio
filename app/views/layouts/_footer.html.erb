<footer class="footer">
  <div class="footer__container">
    <div class="footer__brand">
      <h3 class="footer__brand-name">Avi Lace Studio</h3>
      <p class="footer__tagline">Premium Laces &amp; Trims — Wholesale &amp; Retail</p>
      <p class="footer__address">Mumbai, Maharashtra, India</p>
      <div class="footer__social">
        <a href="#" class="footer__social-link" aria-label="Facebook">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="#" class="footer__social-link" aria-label="Instagram">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
      </div>
    </div>

    <div class="footer__links">
      <h4>Shop</h4>
      <ul>
        <li><%= link_to "All Products", products_path %></li>
        <% Category.root_categories.limit(5).each do |cat| %>
          <li><%= link_to cat.name, category_path(cat.slug) %></li>
        <% end %>
      </ul>
    </div>

    <div class="footer__links">
      <h4>Account</h4>
      <ul>
        <% if user_signed_in? %>
          <li><%= link_to "My Profile", account_profile_path %></li>
          <li><%= link_to "My Orders", account_orders_path %></li>
          <li><%= link_to "Wishlist", account_wishlists_path %></li>
          <li><%= link_to "Addresses", account_addresses_path %></li>
        <% else %>
          <li><%= link_to "Login", new_user_session_path %></li>
          <li><%= link_to "Create Account", new_user_registration_path %></li>
        <% end %>
      </ul>
    </div>

    <div class="footer__links">
      <h4>Contact</h4>
      <ul>
        <li><a href="tel:+919999999999">+91 99999 99999</a></li>
        <li><a href="mailto:info@avilacestudio.com">info@avilacestudio.com</a></li>
        <li>Mon–Sat, 10:00–18:30 IST</li>
      </ul>
    </div>
  </div>
  <div class="footer__bottom">
    <p>&copy; <%= Date.current.year %> Avi Lace Studio. All rights reserved.</p>
  </div>
</footer>
