<style nonce="<%= content_security_policy_nonce %>">
  .whatsapp-btn {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 999;
    background: #25D366;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px 12px 14px;
    border-radius: 50px;
    box-shadow: 0 4px 16px rgba(37,211,102,.4);
    text-decoration: none;
    font-family: 'Work Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    transition: transform .2s, box-shadow .2s;
    max-width: 180px;
  }
  .whatsapp-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(37,211,102,.5);
    color: #ffffff;
  }
  .whatsapp-btn__label {
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .whatsapp-btn {
      bottom: 20px;
      right: 20px;
      padding: 12px;
      border-radius: 50%;
      max-width: unset;
    }
    .whatsapp-btn__label { display: none; }
  }
</style>
