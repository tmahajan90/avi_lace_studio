<div class="admin-page-header">
  <h1>Customers</h1>
</div>
<div class="admin-card">
  <table class="admin-table">
    <thead><tr><th>Name</th><th>Email</th><th>Orders</th><th>Joined</th><th></th></tr></thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><strong><%= user.name %></strong></td>
          <td><%= user.email %></td>
          <td><%= user.orders.size %></td>
          <td><%= user.created_at.strftime("%d %b %Y") %></td>
          <td><%= link_to "View", admin_user_path(user), class: "btn btn--sm btn--outline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="pagination"><%= paginate @users %></div>
</div>
<style nonce="<%= content_security_policy_nonce %>">
  .admin-page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
  .admin-page-header h1 { font-size: 26px; }
  .admin-card { background: white; border-radius: 11px; padding: 0 24px 24px; box-shadow: 0 1px 3px rgba(38,32,26,.08); }
  .admin-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .admin-table th { text-align: left; padding: 14px 10px; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #726365; border-bottom: 1.5px solid #e4e0dd; }
  .admin-table td { padding: 12px 10px; border-bottom: 1px solid #f0eded; }
</style>
