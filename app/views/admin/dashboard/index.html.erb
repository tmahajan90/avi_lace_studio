<div class="admin-header">
  <h1>Dashboard</h1>
</div>

<div class="admin-stats">
  <div class="stat-card">
    <div class="stat-card__label">Total Orders</div>
    <div class="stat-card__value"><%= @total_orders %></div>
  </div>
  <div class="stat-card">
    <div class="stat-card__label">Pending Orders</div>
    <div class="stat-card__value"><%= @pending_orders %></div>
  </div>
  <div class="stat-card">
    <div class="stat-card__label">Total Revenue</div>
    <div class="stat-card__value">&#8377;<%= number_with_precision(@total_revenue, precision: 2) %></div>
  </div>
  <div class="stat-card">
    <div class="stat-card__label">Active Products</div>
    <div class="stat-card__value"><%= @total_products %></div>
  </div>
</div>

<div class="admin-grid">
  <div class="admin-card">
    <h3>Recent Orders</h3>
    <table class="admin-table">
      <thead>
        <tr><th>Order #</th><th>Customer</th><th>Total</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% @recent_orders.each do |order| %>
          <tr>
            <td><%= order.order_number %></td>
            <td><%= order.user.name %></td>
            <td>&#8377;<%= number_with_precision(order.total_amount, precision: 2) %></td>
            <td><span class="status-badge status-badge--<%= order.status %>"><%= order.status.humanize %></span></td>
            <td><%= link_to "View", admin_order_path(order), class: "link" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="admin-card">
    <h3>Low Stock Products</h3>
    <table class="admin-table">
      <thead>
        <tr><th>Product</th><th>Stock</th><th></th></tr>
      </thead>
      <tbody>
        <% @low_stock_products.each do |product| %>
          <tr>
            <td><%= product.name %></td>
            <td class="<%= product.stock_quantity == 0 ? 'text-danger' : 'text-warning' %>"><%= product.stock_quantity %></td>
            <td><%= link_to "Edit", edit_admin_product_path(product), class: "link" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<style nonce="<%= content_security_policy_nonce %>">
  .admin-header { margin-bottom: 28px; }
  .admin-header h1 { font-size: 28px; }
  .admin-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px; }
  .stat-card { background: white; border-radius: 11px; padding: 24px; box-shadow: 0 1px 3px rgba(38,32,26,.08); }
  .stat-card__label { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #726365; margin-bottom: 8px; }
  .stat-card__value { font-size: 28px; font-family: 'Playfair Display', serif; font-weight: 700; color: #26201a; }
  .admin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .admin-card { background: white; border-radius: 11px; padding: 24px; box-shadow: 0 1px 3px rgba(38,32,26,.08); }
  .admin-card h3 { font-size: 18px; margin-bottom: 16px; }
  .admin-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .admin-table th { text-align: left; padding: 8px 10px; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #726365; border-bottom: 1.5px solid #e4e0dd; }
  .admin-table td { padding: 10px; border-bottom: 1px solid #f0eded; }
  .status-badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; text-transform: uppercase; background: #f0eded; }
  .text-danger { color: #c0392b; font-weight: 600; }
  .text-warning { color: #e67e22; font-weight: 600; }
</style>
