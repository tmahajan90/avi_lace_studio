<%= form_with model: [:admin, category], class: "product-form" do |f| %>
  <% if category.errors.any? %>
    <div class="flash flash--alert">
      <% category.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <div class="form-group">
    <%= f.label :name, "Category Name", class: "form-label" %>
    <%= f.text_field :name, class: "form-input", required: true %>
  </div>
  <div class="form-group">
    <%= f.label :description, "Description", class: "form-label" %>
    <%= f.text_area :description, class: "form-textarea", rows: 3 %>
  </div>
  <div class="form-group">
    <%= f.label :parent_id, "Parent Category (optional)", class: "form-label" %>
    <%= f.collection_select :parent_id, Category.root_categories.where.not(id: category.id), :id, :name, { include_blank: "None (Top Level)" }, class: "form-select" %>
  </div>
  <div class="form-actions">
    <%= f.submit category.persisted? ? "Update Category" : "Create Category", class: "btn btn--primary" %>
    <%= link_to "Cancel", admin_categories_path, class: "btn btn--outline" %>
  </div>
<% end %>
<style nonce="<%= content_security_policy_nonce %>">
  .product-form { background: white; border-radius: 11px; padding: 28px; box-shadow: 0 1px 3px rgba(38,32,26,.08); max-width: 560px; }
  .form-actions { display: flex; gap: 12px; margin-top: 24px; }
</style>
