<% content_for :title, "Order Confirmed — Avi Lace Studio" %>

<div class="confirmation-page">
  <div class="confirmation-box">
    <div class="confirmation-icon">&#10003;</div>
    <h1>Order Placed Successfully!</h1>
    <p>Thank you for your order. We'll process it shortly.</p>
    <div class="confirmation-details">
      <p><strong>Order Number:</strong> <%= @order.order_number %></p>
      <p><strong>Total:</strong> &#8377;<%= number_with_precision(@order.total_amount, precision: 2) %></p>
      <p><strong>Status:</strong> <%= @order.status.humanize %></p>
    </div>
    <div style="display: flex; gap: 12px; justify-content: center; margin-top: 24px;">
      <%= link_to "View Order", account_order_path(@order), class: "btn btn--primary" %>
      <%= link_to "Continue Shopping", products_path, class: "btn btn--outline" %>
    </div>
  </div>
</div>

<style nonce="<%= content_security_policy_nonce %>">
  .confirmation-page { display: flex; align-items: center; justify-content: center; min-height: 60vh; padding: 40px 24px; }
  .confirmation-box { text-align: center; background: white; border-radius: 16px; padding: 48px; box-shadow: 0 4px 16px rgba(38,32,26,.12); max-width: 460px; }
  .confirmation-icon { width: 70px; height: 70px; background: #d4edda; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; color: #155724; margin: 0 auto 20px; }
  .confirmation-box h1 { font-size: 26px; margin-bottom: 10px; }
  .confirmation-box p { color: #726365; margin-bottom: 8px; }
  .confirmation-details { background: #f8f8f8; border-radius: 8px; padding: 16px; margin: 20px 0; text-align: left; }
  .confirmation-details p { font-size: 14px; margin-bottom: 6px; }
</style>
