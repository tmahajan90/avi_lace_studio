<div class="page-header">
  <h2>My Addresses</h2>
  <%= link_to "Add New Address", new_account_address_path, class: "btn btn--primary btn--sm" %>
</div>

<% if @addresses.any? %>
  <div class="address-grid">
    <% @addresses.each do |addr| %>
      <div class="address-card">
        <p class="address-type"><%= addr.address_type.humanize %></p>
        <p><strong><%= addr.full_name %></strong></p>
        <p><%= addr.address_line1 %></p>
        <p><%= addr.address_line2 %></p>
        <p><%= addr.city %>, <%= addr.state %> <%= addr.pincode %></p>
        <p>Phone: <%= addr.phone %></p>
        <div class="address-actions">
          <%= link_to "Edit", edit_account_address_path(addr), class: "link" %>
          <%= button_to "Remove", account_address_path(addr), method: :delete, data: { turbo_confirm: "Remove this address?" }, class: "btn-link text-danger" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <p>No saved addresses.</p>
    <%= link_to "Add Address", new_account_address_path, class: "btn btn--primary" %>
  </div>
<% end %>

<style nonce="<%= content_security_policy_nonce %>">
  .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .page-header h2 { font-size: 24px; }
  .address-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .address-card { background: white; border-radius: 11px; padding: 20px; box-shadow: 0 1px 3px rgba(38,32,26,.08); }
  .address-type { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #b1655b; font-weight: 600; margin-bottom: 8px; }
  .address-card p { font-size: 14px; color: #3c3131; margin-bottom: 3px; }
  .address-actions { display: flex; gap: 10px; margin-top: 14px; }
  .btn-link { background: none; border: none; cursor: pointer; font-size: 13px; padding: 0; }
  .text-danger { color: #c0392b; }
</style>
