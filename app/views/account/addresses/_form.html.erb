<%= form_with model: [:account, address], class: "edit-form" do |f| %>
  <% if address.errors.any? %>
    <div class="flash flash--alert">
      <% address.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <div class="form-group">
    <%= f.label :full_name, "Full Name", class: "form-label" %>
    <%= f.text_field :full_name, class: "form-input", required: true %>
  </div>
  <div class="form-group">
    <%= f.label :phone, "Phone Number", class: "form-label" %>
    <%= f.text_field :phone, class: "form-input", placeholder: "10-digit mobile", required: true %>
  </div>
  <div class="form-group">
    <%= f.label :address_line1, "Address Line 1", class: "form-label" %>
    <%= f.text_field :address_line1, class: "form-input", required: true %>
  </div>
  <div class="form-group">
    <%= f.label :address_line2, "Address Line 2 (optional)", class: "form-label" %>
    <%= f.text_field :address_line2, class: "form-input" %>
  </div>
  <div class="form-row">
    <div class="form-group">
      <%= f.label :city, "City", class: "form-label" %>
      <%= f.text_field :city, class: "form-input", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :state, "State", class: "form-label" %>
      <%= f.text_field :state, class: "form-input", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :pincode, "Pincode", class: "form-label" %>
      <%= f.text_field :pincode, class: "form-input", placeholder: "6 digits", required: true %>
    </div>
  </div>
  <div class="form-group">
    <%= f.label :address_type, "Address Type", class: "form-label" %>
    <%= f.select :address_type, Address.address_types.keys.map { |t| [t.humanize, t] }, {}, class: "form-select" %>
  </div>
  <div style="display: flex; gap: 10px; margin-top: 20px;">
    <%= f.submit address.persisted? ? "Update Address" : "Save Address", class: "btn btn--primary" %>
    <%= link_to "Cancel", account_addresses_path, class: "btn btn--outline" %>
  </div>
<% end %>
<style nonce="<%= content_security_policy_nonce %>">
  .edit-form { background: white; border-radius: 11px; padding: 24px; box-shadow: 0 1px 3px rgba(38,32,26,.08); max-width: 560px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
</style>
