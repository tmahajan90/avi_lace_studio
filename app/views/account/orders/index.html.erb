<h2>My Orders</h2>
<% if @orders.any? %>
  <div class="orders-list">
    <% @orders.each do |order| %>
      <div class="order-row">
        <div>
          <strong><%= order.order_number %></strong>
          <p><%= order.created_at.strftime("%d %b %Y") %> &bull; <%= order.order_items.count %> item(s)</p>
        </div>
        <div>
          <span class="status-badge"><%= order.status.humanize %></span>
          <span class="status-badge"><%= order.payment_status.humanize %></span>
        </div>
        <strong>&#8377;<%= number_with_precision(order.total_amount, precision: 2) %></strong>
        <%= link_to "View", account_order_path(order), class: "btn btn--outline btn--sm" %>
      </div>
    <% end %>
  </div>
  <div class="pagination"><%= paginate @orders %></div>
<% else %>
  <div class="empty-state">
    <p>No orders yet.</p>
    <%= link_to "Start Shopping", products_path, class: "btn btn--primary" %>
  </div>
<% end %>
<style nonce="<%= content_security_policy_nonce %>">
  h2 { font-size: 26px; margin-bottom: 20px; }
  .orders-list { display: flex; flex-direction: column; gap: 12px; }
  .order-row { background: white; border-radius: 11px; padding: 18px 20px; box-shadow: 0 1px 3px rgba(38,32,26,.08); display: flex; align-items: center; gap: 16px; }
  .order-row > div:first-child { flex: 1; }
  .order-row strong { font-size: 15px; }
  .order-row p { font-size: 13px; color: #726365; margin-top: 2px; }
  .status-badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; background: #f0eded; margin-right: 4px; }
</style>
