<h2>Order <%= @order.order_number %></h2>
<p><small>Placed on <%= @order.created_at.strftime("%d %B %Y, %I:%M %p") %></small></p>

<div class="order-detail">
  <div class="order-items-card">
    <h3>Items</h3>
    <% @order.order_items.each do |item| %>
      <div class="order-item-row">
        <div>
          <strong><%= item.product_name %></strong>
          <p>Qty: <%= item.quantity %> &times; &#8377;<%= number_with_precision(item.unit_price, precision: 2) %></p>
        </div>
        <strong>&#8377;<%= number_with_precision(item.total_price, precision: 2) %></strong>
      </div>
    <% end %>
    <div class="order-total">
      <span>Total</span>
      <strong>&#8377;<%= number_with_precision(@order.total_amount, precision: 2) %></strong>
    </div>
  </div>
  <div class="order-info-card">
    <h3>Order Info</h3>
    <p><strong>Status:</strong> <span class="status-badge"><%= @order.status.humanize %></span></p>
    <p><strong>Payment:</strong> <span class="status-badge"><%= @order.payment_status.humanize %></span></p>
    <p><strong>Method:</strong> <%= @order.payment_method&.humanize %></p>
    <% if @order.shipping_address.present? %>
      <hr style="border-color:#f0eded; margin: 12px 0;">
      <h3>Delivery Address</h3>
      <% addr = @order.shipping_address %>
      <p style="margin-bottom:4px;"><strong><%= addr.full_name %></strong></p>
      <p><%= addr.address_line1 %><%= ", #{addr.address_line2}" if addr.address_line2.present? %></p>
      <p><%= addr.city %>, <%= addr.state %> — <%= addr.pincode %></p>
      <p>&#128222; <%= addr.phone %></p>
    <% end %>
  </div>
</div>
<br>
<%= link_to "Back to Orders", account_orders_path, class: "btn btn--outline" %>

<style nonce="<%= content_security_policy_nonce %>">
  h2 { font-size: 24px; margin-bottom: 4px; }
  h2 + p { color: #726365; font-size: 13px; margin-bottom: 20px; }
  .order-detail { display: grid; grid-template-columns: 1fr 280px; gap: 20px; }
  .order-items-card, .order-info-card { background: white; border-radius: 11px; padding: 24px; box-shadow: 0 1px 3px rgba(38,32,26,.08); }
  .order-items-card h3, .order-info-card h3 { font-size: 17px; margin-bottom: 16px; }
  .order-info-card p { font-size: 14px; margin-bottom: 10px; }
  .order-item-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f0eded; }
  .order-item-row p { font-size: 13px; color: #726365; margin-top: 2px; }
  .order-total { display: flex; justify-content: space-between; padding-top: 12px; font-size: 16px; }
  .status-badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; background: #f0eded; }
</style>
