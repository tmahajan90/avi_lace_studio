<h2>Edit Profile</h2>
<%= form_with model: current_user, url: account_profile_path, method: :patch, class: "edit-form" do |f| %>
  <% if current_user.errors.any? %>
    <div class="flash flash--alert">
      <% current_user.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <div class="form-group">
    <%= f.label :name, "Full Name", class: "form-label" %>
    <%= f.text_field :name, class: "form-input" %>
  </div>
  <div class="form-group">
    <%= f.label :phone, "Phone Number", class: "form-label" %>
    <%= f.text_field :phone, class: "form-input", placeholder: "10-digit mobile number" %>
  </div>
  <div style="display: flex; gap: 10px;">
    <%= f.submit "Save Changes", class: "btn btn--primary" %>
    <%= link_to "Cancel", account_profile_path, class: "btn btn--outline" %>
  </div>
<% end %>
<style nonce="<%= content_security_policy_nonce %>">
  h2 { font-size: 26px; margin-bottom: 20px; }
  .edit-form { background: white; border-radius: 11px; padding: 24px; box-shadow: 0 1px 3px rgba(38,32,26,.08); max-width: 480px; }
</style>
